# =======================================================
# AREA ANNOTATOR - ENVIRONMENT CONFIGURATION TEMPLATE
# =======================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini API Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Client Configuration (Optional for Cloud Storage & Firestore sync)
# Get these from your Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin Service Account (SERVER-SIDE ONLY - Optional)
# Path to your downloaded service account JSON file, or inline JSON string
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
